{
  "name": "Afterburner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.18.3 --activate && pnpm install --frozen-lockfile",
  "portsAttributes": {
    "8080": {
      "label": "Afterburner",
      "onAutoForward": "notify",
      "protocol": "https"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
